  function setupGlyphMatrix() {
    const gridContainer = document.getElementById("glyph-grid");
    const faceTag = document.getElementById("glyph-face-tag");
    const reactionText = document.getElementById("glyph-reaction");
    const screen = document.getElementById("glyph-screen");

    if (!gridContainer) return;

    const GRID_SIZE = 15;
    const TOTAL_DOTS = GRID_SIZE * GRID_SIZE; // 225

    // Create LED dots
    gridContainer.innerHTML = "";
    const dots: HTMLDivElement[] = [];
    for (let i = 0; i < TOTAL_DOTS; i++) {
      const dot = document.createElement("div");
      dot.className = "glyph-dot";
      gridContainer.appendChild(dot);
      dots.push(dot);
    }

    let currentIndex = 0;

    function renderFace(index: number) {
      currentIndex = index % GLYPH_FACES.length;
      const face = GLYPH_FACES[currentIndex];

      if (faceTag) faceTag.textContent = face.id;
      if (reactionText) reactionText.textContent = face.text;

      let dotIndex = 0;
      for (let r = 0; r < GRID_SIZE; r++) {
        // Guard against short rows so a typo can never shift the grid
        const rowStr = (face.grid[r] ?? "").padEnd(GRID_SIZE, "0");
        for (let c = 0; c < GRID_SIZE; c++) {
          const isOn = rowStr[c] === "1";
          const dot = dots[dotIndex];
          if (dot) {
            dot.className = "glyph-dot";
            if (isOn) {
              dot.classList.add(face.isRed ? "active-red" : "active");
            }
          }
          dotIndex++;
        }
      }
    }

    function spawnParticle(x: number, y: number, emoji: string) {
      const particle = document.createElement("span");
      particle.className = "glyph-particle";
      particle.textContent = emoji;
      particle.style.left = `${x}px`;
      particle.style.top = `${y}px`;
      document.body.appendChild(particle);
      setTimeout(() => particle.remove(), 900);
    }

    // Shuffle-bag: prioritize unseen faces, reset when all shown
    const seenIndices = new Set<number>();
    seenIndices.add(currentIndex);

    function getRandomIndex(exclude: number): number {
      // Build pool of unseen indices (excluding current)
      let pool = Array.from({ length: GLYPH_FACES.length }, (_, i) => i).filter(
        (i) => i !== exclude && !seenIndices.has(i),
      );

      // If all faces have been seen, reset and allow any except current
      if (pool.length === 0) {
        seenIndices.clear();
        pool = Array.from({ length: GLYPH_FACES.length }, (_, i) => i).filter(
          (i) => i !== exclude,
        );
      }

      const next = pool[Math.floor(Math.random() * pool.length)];
      seenIndices.add(next);
      return next;
    }

    function nextExpression(e?: Event) {
      renderFace(getRandomIndex(currentIndex));

      if (screen) {
        screen.classList.add("scale-[1.03]");
        setTimeout(() => screen.classList.remove("scale-[1.03]"), 180);
      }

      if (e) {
        const mouseEvent = e as MouseEvent;
        const rect = screen?.getBoundingClientRect();
        if (rect) {
          const x = mouseEvent.clientX || rect.left + rect.width / 2;
          const y = mouseEvent.clientY || rect.top + rect.height / 2;
          const glyphs = [
            "*",
            "#",
            "+",
            "×",
            "◆",
            "◇",
            "●",
            "○",
            "■",
            "□",
            "▲",
            "△",
            "★",
            "☆",
            "♦",
          ];
          spawnParticle(
            x,
            y,
            glyphs[Math.floor(Math.random() * glyphs.length)],
          );
        }
      }
    }

    let autoTimer: ReturnType<typeof setInterval> | null = null;

    function resetTimer() {
      if (autoTimer) clearInterval(autoTimer);
      autoTimer = setInterval(() => {
        nextExpression();
      }, 6000);
    }

    screen?.addEventListener("click", (e) => {
      nextExpression(e);
      resetTimer();
    });

    // Initial render (SMILE)
    renderFace(currentIndex);

    // Start auto-cycle
    resetTimer();

    // Clean up when navigating away
    document.addEventListener(
      "astro:before-swap",
      () => {
        if (autoTimer) clearInterval(autoTimer);
      },
      { once: true },
    );
  }

  document.addEventListener("astro:page-load", setupGlyphMatrix);
</script>
