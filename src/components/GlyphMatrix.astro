---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  id="glyph-matrix-widget"
  class={`relative overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-surface-dim)] bg-[var(--color-surface-container)] p-5 backdrop-blur-md shadow-lg select-none transition-all duration-300 hover:border-[var(--color-primary)]/50 ${className}`}
>
  <!-- Header -->
  <div
    class="flex items-center justify-between border-b border-[var(--color-surface-dim)] pb-2.5 mb-3 font-mono text-[10px] tracking-wider text-[var(--color-secondary)]"
  >
    <div class="flex items-center gap-1.5"></div>
    <span
      id="glyph-face-tag"
      class="rounded bg-[var(--color-surface)] px-1.5 py-0.5 border border-[var(--color-surface-dim)] text-[9px] font-semibold text-[var(--color-primary)]"
    >
      SMILE
    </span>
  </div>

  <!-- The Glyph Display Container -->
  <div class="relative mx-auto flex flex-col items-center justify-center">
    <!-- Matrix Frame — background seamlessly matches widget -->
    <div
      id="glyph-screen"
      class="glyph-screen-bg group relative flex items-center justify-center cursor-pointer rounded-2xl border border-[var(--color-surface-dim)] p-4 transition-transform duration-300 active:scale-95"
      title="Tap to change glyph!"
    >
      <!-- Circuit trace corner markings -->
      <div
        class="pointer-events-none absolute top-1.5 left-1.5 h-2.5 w-2.5 border-t border-l border-[var(--color-outline)]/20"
      >
      </div>
      <div
        class="pointer-events-none absolute top-1.5 right-1.5 h-2.5 w-2.5 border-t border-r border-[var(--color-outline)]/20"
      >
      </div>
      <div
        class="pointer-events-none absolute bottom-1.5 left-1.5 h-2.5 w-2.5 border-b border-l border-[var(--color-outline)]/20"
      >
      </div>
      <div
        class="pointer-events-none absolute bottom-1.5 right-1.5 h-2.5 w-2.5 border-b border-r border-[var(--color-outline)]/20"
      >
      </div>

      <!-- 15x15 LED Dot Matrix — true center at column 7 -->
      <div id="glyph-grid" class="glyph-grid-15">
        <!-- 225 LEDs generated dynamically by script -->
      </div>
    </div>

    <!-- Caption -->
    <p
      id="glyph-reaction"
      class="mt-3 font-mono text-xs font-semibold text-[var(--color-primary)] text-center transition-all duration-200"
    >
      :) hi
    </p>

    <!-- Tap hint -->
    <p
      class="mt-1 font-mono text-[10px] text-[var(--color-secondary)]/70 text-center"
    >
      tap to change
    </p>
  </div>
</div>

<style>
  /* Grid screen background blends seamlessly with parent widget */
  .glyph-screen-bg {
    background-color: transparent;
    box-shadow: none;
  }

  /* 15x15 grid with fixed dot sizes — true center at column 7 */
  .glyph-grid-15 {
    display: grid;
    grid-template-columns: repeat(15, 11px);
    grid-template-rows: repeat(15, 11px);
    gap: 3px;
    width: calc(15 * 11px + 14 * 3px); /* 207px */
    height: calc(15 * 11px + 14 * 3px);
  }

  /* Each LED dot — fixed 11px square */
  :global(.glyph-dot) {
    width: 11px;
    height: 11px;
    border-radius: 2.5px;
    background-color: var(--color-surface-dim);
    transition: none;
  }

  /* Active LED — uses primary accent color with glow */
  :global(.glyph-dot.active) {
    background-color: var(--color-primary);
    box-shadow:
      0 0 4px var(--color-primary),
      0 0 8px var(--color-primary);
  }

  /* Red accent LED */
  :global(.glyph-dot.active-red) {
    background-color: #ef4444;
    box-shadow:
      0 0 4px #ef4444,
      0 0 8px #ef4444;
  }

  /* Floating particle */
  :global(.glyph-particle) {
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    font-size: 1.5rem;
    animation: glyphFloatUp 0.9s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
  }

  @keyframes glyphFloatUp {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.6);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -60px) scale(1.3);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -110px) scale(1);
    }
  }
</style>

