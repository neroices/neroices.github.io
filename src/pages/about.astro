---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About — neroices">
  <section class="pb-24 pt-8 md:pt-16">
    <p
      class="mb-4 font-bold underline decoration-wavy decoration-[var(--color-secondary)] decoration-2 text-[var(--color-primary)]"
    >
      A little about me ^^
    </p>
    <div
      class="mt-10 max-w-2xl space-y-5 text-lg leading-relaxed text-[var(--color-ink)]/85"
    >
      <p>I'm a software developer who's pretty much always been into tech.</p>
      <p>
        I mostly work with Astro and Next.js, but I've also worked with Hugo,
        Docusaurus, and VitePress. I've built websites for clients as a
        freelancer and have spent quite a bit of time making documentation sites
        too.

        <p>
          When I'm not coding, you'll probably find me watching random videos on
          YouTube or playing games.
        </p>
      </p>
    </div>
  </section>
</Layout>
