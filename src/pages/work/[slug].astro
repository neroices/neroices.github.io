---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: p }));
}

interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  accent: string;
  type: "personal" | "organization";
  year: string;
  category?: string;
  body: string;
  org?: string;
  link?: string;
  preview?: string;
}

const { title, description, body, tags, accent, year, category, org, link, preview } =
  Astro.props;
---

<Layout title={`${title} — neroices`}>
  <section class="pb-24 pt-8 md:pt-16">
    <a
      href="/"
      class="text-sm text-[var(--color-secondary)] hover:text-[var(--color-primary)]"
    >
      ← Work
    </a>

    <div
      class="theme-transition mt-6 rounded-[var(--radius-xl)] p-6 sm:p-10 md:p-16"
      style={`background:${accent}`}
    >
      {
        org && (
          <p class="mb-2 text-sm font-medium text-[var(--color-ink)]/60">
            {org}
          </p>
        )
      }
      <div class="flex flex-wrap items-start justify-between gap-4">
        <h1
          class="font-[var(--font-display)] text-4xl font-bold md:text-6xl"
          style="font-variation-settings: 'wght' 800;"
        >
          {title}
        </h1>
        <div class="flex flex-wrap gap-2">
          {
            preview && (
              <a
                href={preview}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-white/70 px-5 py-2.5 text-sm font-medium text-[var(--color-chip-ink)] transition-all hover:bg-white hover:scale-105"
              >
                Visit Website ↗
              </a>
            )
          }
          {
            link && (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition-all hover:scale-105",
                  preview
                    ? "bg-black/10 text-[var(--color-ink)] hover:bg-black/15 dark:bg-white/20 dark:hover:bg-white/30"
                    : "bg-white/70 text-[var(--color-chip-ink)] hover:bg-white",
                ]}
              >
                {link.includes("github.com") ? "GitHub ↗" : "Visit Website ↗"}
              </a>
            )
          }
        </div>
      </div>
      <p class="mt-4 max-w-lg text-lg">{description}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          tags.map((t: string) => (
            <li class="rounded-full bg-white/55 px-3 py-1 text-xs font-medium text-[var(--color-chip-ink)]">
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-[1fr_2fr]">
      <dl class="space-y-6 text-sm">
        <div>
          <dt class="text-[var(--color-secondary)]">Year</dt>
          <dd class="font-medium">{year}</dd>
        </div>
        {
          category && (
            <div>
              <dt class="text-[var(--color-secondary)]">Category</dt>
              <dd class="font-medium">{category}</dd>
            </div>
          )
        }
        {
          preview && (
            <div>
              <dt class="text-[var(--color-secondary)]">Live Site</dt>
              <dd class="font-medium">
                <a
                  href={preview}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--color-primary)] hover:underline"
                >
                  {preview.replace(/^https?:\/\//, "")} ↗
                </a>
              </dd>
            </div>
          )
        }
        {
          link && (
            <div>
              <dt class="text-[var(--color-secondary)]">
                {link.includes("github.com") ? "Repository" : "Link"}
              </dt>
              <dd class="font-medium">
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--color-primary)] hover:underline"
                >
                  {link.replace(/^https?:\/\//, "")} ↗
                </a>
              </dd>
            </div>
          )
        }
      </dl>
      <p class="max-w-2xl text-lg text-[var(--color-ink)]/85">{body}</p>
    </div>

    {
      preview && (
        <div class="mt-16">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="font-[var(--font-display)] text-2xl font-bold">
              Live Preview
            </h2>
            <a
              href={preview}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-[var(--color-primary)] hover:underline"
            >
              Open in new tab ↗
            </a>
          </div>

          <div class="overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-surface-dim)] bg-[var(--color-surface-container)] shadow-lg shadow-black/5">
            <div class="flex items-center gap-2 border-b border-[var(--color-surface-dim)] px-4 py-3 bg-[var(--color-surface)]/70">
              <div class="flex items-center gap-1.5">
                <div class="h-3 w-3 rounded-full bg-red-400/80" />
                <div class="h-3 w-3 rounded-full bg-yellow-400/80" />
                <div class="h-3 w-3 rounded-full bg-green-400/80" />
              </div>
              <div class="mx-auto flex w-full max-w-sm items-center justify-center truncate rounded-full bg-[var(--color-surface-container)] px-3 py-1 text-xs text-[var(--color-secondary)]">
                {preview}
              </div>
            </div>

            <iframe
              src={preview}
              title={`${title} live preview`}
              class="h-[520px] w-full border-0 bg-white md:h-[620px]"
              loading="lazy"
            />
          </div>
        </div>
      )
    }
  </section>
</Layout>
