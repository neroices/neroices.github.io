---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: p }));
}

interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  accent: string;
  type: "personal" | "organization";
  year: string;
  category?: string;
  body: string;
  org?: string;
  link?: string;
  preview?: string;
}

const {
  title,
  description,
  body,
  tags,
  accent,
  year,
  category,
  org,
  link,
  preview,
} = Astro.props;
---

<Layout title={`${title} — neroices`}>
  <section class="pb-24 pt-8 md:pt-16">
    <a
      href="/"
      class="text-sm text-[var(--color-secondary)] hover:text-[var(--color-primary)]"
    >
      ← Home
    </a>

    <div
      class="theme-transition mt-6 rounded-[var(--radius-xl)] p-6 sm:p-10 md:p-16"
      style={`background:${accent}`}
    >
      {
        org && (
          <p class="mb-2 text-sm font-medium text-[var(--color-ink)]/60">
            {org}
          </p>
        )
      }
      <div class="flex flex-wrap items-start justify-between gap-4">
        <h1
          class="font-[var(--font-display)] text-4xl font-bold md:text-6xl"
          style="font-variation-settings: 'wght' 800;"
        >
          {title}
        </h1>
        <div class="flex flex-wrap gap-2">
          {
            preview && (
              <a
                href={preview}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-lift inline-flex items-center gap-2 rounded-full bg-white/70 px-5 py-2.5 text-sm font-medium text-[var(--color-chip-ink)] hover:bg-white"
              >
                Visit Website ↗
              </a>
            )
          }
          {
            link && (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "btn-lift inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium",
                  preview
                    ? "bg-black/10 text-[var(--color-ink)] hover:bg-black/15 dark:bg-white/20 dark:hover:bg-white/30"
                    : "bg-white/70 text-[var(--color-chip-ink)] hover:bg-white",
                ]}
              >
                {link.includes("github.com") ? "GitHub ↗" : "Visit Website ↗"}
              </a>
            )
          }
        </div>
      </div>
      <p class="mt-4 max-w-lg text-lg">{description}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          tags.map((t: string) => (
            <li class="rounded-full bg-white/55 px-3 py-1 text-xs font-medium text-[var(--color-chip-ink)]">
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-[1fr_2fr]">
      <dl class="space-y-6 text-sm">
        <div>
          <dt class="text-[var(--color-secondary)]">Year</dt>
          <dd class="font-medium">{year}</dd>
        </div>
        {
          category && (
            <div>
              <dt class="text-[var(--color-secondary)]">Category</dt>
              <dd class="font-medium">{category}</dd>
            </div>
          )
        }
        {
          preview && (
            <div>
              <dt class="text-[var(--color-secondary)]">Live Site</dt>
              <dd class="font-medium">
                <a
                  href={preview}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--color-primary)] hover:underline"
                >
                  {preview.replace(/^https?:\/\//, "")} ↗
                </a>
              </dd>
            </div>
          )
        }
        {
          link && (
            <div>
              <dt class="text-[var(--color-secondary)]">
                {link.includes("github.com") ? "Repository" : "Link"}
              </dt>
              <dd class="font-medium">
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--color-primary)] hover:underline"
                >
                  {link.replace(/^https?:\/\//, "")} ↗
                </a>
              </dd>
            </div>
          )
        }
      </dl>
      <p class="max-w-2xl text-lg text-[var(--color-ink)]/85">{body}</p>
    </div>

    {
      preview && (
        <div class="mt-16">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="font-[var(--font-display)] text-2xl font-bold">
              Live Preview
            </h2>
            <a
              href={preview}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-[var(--color-primary)] hover:underline"
            >
              Open in new tab ↗
            </a>
          </div>

          <div class="relative overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-surface-dim)] bg-[var(--color-surface-container)] shadow-lg shadow-black/5">
            <div class="flex items-center justify-between gap-2 border-b border-[var(--color-surface-dim)] px-3 py-2.5 sm:px-4 sm:py-3 bg-[var(--color-surface)]/70">
              <div class="flex items-center gap-1.5 shrink-0">
                <div class="h-2.5 w-2.5 sm:h-3 sm:w-3 rounded-full bg-red-400/80" />
                <div class="h-2.5 w-2.5 sm:h-3 sm:w-3 rounded-full bg-yellow-400/80" />
                <div class="h-2.5 w-2.5 sm:h-3 sm:w-3 rounded-full bg-green-400/80" />
              </div>
              <div class="mx-auto flex min-w-0 max-w-sm items-center justify-center rounded-full bg-[var(--color-surface-container)] px-3 py-1 text-xs text-[var(--color-secondary)]">
                <span class="truncate">{preview}</span>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                <a
                  href={preview}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shrink-0 text-xs text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors p-1"
                  aria-label="Open preview in new tab"
                  title="Open preview in new tab"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </a>
              </div>
            </div>

            <iframe
              src={preview}
              title={`${title} live preview`}
              class="h-[520px] w-full border-0 bg-white sm:h-[620px]"
              loading="lazy"
            />
          </div>
        </div>
      )
    }
  </section>
</Layout>
