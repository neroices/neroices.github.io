---
import Layout from "../layouts/Layout.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { socials } from "../data/socials.js";
---

<Layout title="Contact — neroices">
  <section class="pb-24 pt-8 md:pt-16">
    <h1
      class="mb-4 font-[var(--font-display)] text-5xl font-bold md:text-6xl"
      style="font-variation-settings: 'wght' 800;"
    >
      Get in touch
    </h1>
    <p class="mb-10 max-w-lg text-lg text-[var(--color-secondary)]">
      You can find me on a few platforms around the internet. Feel free to take
      a look, follow along, or just say hi when appropriate :)
    </p>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="theme-transition group flex items-center justify-between rounded-[var(--radius-xl)] p-6 transition-transform duration-300 hover:scale-[1.01]"
            style={`background:${s.accent}`}
          >
            <div class="flex items-center gap-4">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-white/70 text-[var(--color-chip-ink)] transition-colors group-hover:bg-white">
                <SocialIcon name={s.name} class="h-6 w-6" />
              </span>
              <div>
                <p class="font-[var(--font-display)] text-xl font-bold">
                  {s.name}
                </p>
                <p class="mt-1 text-sm text-[var(--color-ink)]/70">
                  {s.handle}
                </p>
              </div>
            </div>
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white/70 text-[var(--color-chip-ink)] transition-colors group-hover:bg-white">
              ↗
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
