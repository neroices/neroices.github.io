---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — neroices">
  <section
    class="my-auto flex flex-col items-center justify-center py-8 text-center"
  >
    <div class="relative inline-block">
      <h1
        class="font-[var(--font-display)] text-8xl sm:text-9xl md:text-[11rem] font-black tracking-tighter leading-none text-[var(--color-primary)] select-none"
        style="font-variation-settings: 'wght' 900, 'wdth' 105;"
      >
        404
      </h1>
      <span
        class="absolute -bottom-2 left-1/2 -translate-x-1/2 h-1.5 w-16 rounded-full bg-[var(--color-primary-container)]"
      ></span>
    </div>

    <p
      class="mt-8 font-mono text-xs sm:text-sm font-medium text-[var(--color-primary)] bg-[var(--color-primary-container)]/60 px-3.5 py-1 rounded-full border border-[var(--color-primary)]/20"
    >
      error: target not found (core dumped)
    </p>

    <h2
      class="mt-6 font-[var(--font-display)] text-2xl sm:text-3xl font-bold text-[var(--color-ink)]"
    >
      Looks like you're lost in userspace :p
    </h2>

    <p
      class="mt-3 max-w-md text-base sm:text-lg text-[var(--color-secondary)] leading-relaxed"
    >
      The page you're looking for doesn't exist, got deleted, or was riced into
      oblivion.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="btn-lift inline-flex items-center gap-2 rounded-full bg-[var(--color-primary-container)] px-6 py-2.5 text-sm font-medium text-[var(--color-on-primary-container)] border border-[var(--color-primary)]/20 transition-all hover:bg-[var(--color-primary-container)]/80 hover:border-[var(--color-primary)]/40"
      >
        <span>←</span>
        <span>Return to ~/</span>
      </a>
    </div>
  </section>
</Layout>
