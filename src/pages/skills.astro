---
import Layout from "../layouts/Layout.astro";
import { skillGroups } from "../data/skills.js";
---

<Layout title="Skills — neroices">
  <section class="pb-24 pt-8 md:pt-16">
    <h1
      class="mb-12 font-[var(--font-display)] text-5xl font-bold md:text-6xl"
      style="font-variation-settings: 'wght' 800;"
    >
      Skills
    </h1>

    <div class="grid gap-8 md:grid-cols-2">
      {
        skillGroups.map((group) => (
          <div class="rounded-[var(--radius-xl)] bg-[var(--color-surface-container)] p-6 md:p-8">
            <h2 class="mb-4 text-lg font-medium text-[var(--color-primary)]">
              {group.category}
            </h2>
            <ul class="space-y-4">
              {group.items.map((item) => (
                <li>
                  <p class="font-[var(--font-display)] text-lg font-bold">
                    {item.name}
                  </p>
                  <p class="text-sm text-[var(--color-ink)]/70">{item.note}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
